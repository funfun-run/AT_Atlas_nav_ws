<?xml version="1.0"?>
<robot name="omnibot">

  <!-- [HW_CONFIG] 底盘主体 — 根据实际底盘尺寸和重量修改 -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.2" length="0.1"/>  <!-- [HW_CONFIG] radius=底盘半径(m), length=底盘高度(m) -->
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.2" length="0.1"/>  <!-- [HW_CONFIG] 碰撞模型尺寸，应与 visual 一致 -->
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>  <!-- [HW_CONFIG] 底盘总质量(kg) -->
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>  <!-- [HW_CONFIG] 转动惯量矩阵，根据实际质量分布计算 -->
    </inertial>
  </link>

  <!-- [HW_CONFIG] 2D LiDAR 安装位置 — 根据实际安装偏移修改 -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>  <!-- [HW_CONFIG] LiDAR 外观尺寸，仅可视化 -->
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- [HW_CONFIG] LiDAR joint: x=前后偏移(m), y=左右偏移(m), z=安装高度(m) -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.1 0 0.15" rpy="0 0 0"/>  <!-- [HW_CONFIG] x: 前方为正 | y: 左侧为正 | z: 上方为正 -->
  </joint>

</robot>
